@namespace Quasar.Components.Layout
@using Microsoft.AspNetCore.Components.Web
@using Quasar.Components.Shared
@using Quasar.Ui

@*
    Quasar power actions, rendered as a native dialog.

    PR2 migration: this component no longer uses MudDialog, MudButton, MudAlert,
    MudIcon, or IMudDialogInstance. The native host supplies the top layer,
    focus management, Escape/backdrop policy, and theme. The component only
    requests closure through IQuasarDialogInstance.

    The action/confirmation flow is unchanged: selecting an action replaces the
    choice list with a confirmation, Back returns to the list, and Confirm
    closes with the selected QuasarControlAction.
*@
<header class="quasar-dialog-header">
    <h2 class="quasar-dialog-title">Quasar power</h2>
</header>
<div class="quasar-dialog-content">
    @if (_pendingAction is null)
    {
        <div class="quasar-layout quasar-gap-2">
            <button type="button"
                    class="quasar-button quasar-control-action quasar-tone-warning"
                    disabled="@(!IsRestartAvailable)"
                    @onclick="() => Select(QuasarControlAction.RestartQuasar)">
                <QuasarIcon Icon="@QuasarIcons.RestartAlt" />
                <span>
                    <span class="quasar-control-action-title">Restart Quasar</span>
                    <span class="quasar-control-action-body">Servers continue to run while the web UI restarts.</span>
                </span>
            </button>
            @if (!IsRestartAvailable)
            {
                <span class="quasar-text quasar-type-caption quasar-tone-secondary">@RestartUnavailableReason</span>
            }

            <button type="button"
                    class="quasar-button quasar-control-action quasar-tone-error"
                    @onclick="() => Select(QuasarControlAction.ShutdownQuasar)">
                <QuasarIcon Icon="@QuasarIcons.PowerSettingsNew" />
                <span>
                    <span class="quasar-control-action-title">Shutdown Quasar</span>
                    <span class="quasar-control-action-body">Stop Quasar; servers continue without supervision.</span>
                </span>
            </button>

            <button type="button"
                    class="quasar-button quasar-control-action quasar-tone-error"
                    @onclick="() => Select(QuasarControlAction.ShutdownAllServers)">
                <QuasarIcon Icon="@QuasarIcons.StopCircle" />
                <span>
                    <span class="quasar-control-action-title">Save and stop all servers</span>
                    <span class="quasar-control-action-body">Save and stop standalone servers and managed clusters. Quasar stays online and shows progress.</span>
                </span>
            </button>
        </div>
    }
    else
    {
        <div class="quasar-layout quasar-gap-3">
            <div class="quasar-notice @ConfirmationNoticeClass" role="status">@ConfirmationLead</div>
            <p class="quasar-text quasar-type-body2">@ConfirmationBody</p>
        </div>
    }
</div>
<footer class="quasar-dialog-actions">
    @if (_pendingAction is null)
    {
        <button type="button" class="quasar-button" @onclick="Cancel">Close</button>
    }
    else
    {
        <button type="button" class="quasar-button" @onclick="Back">Back</button>
        <button type="button" class="quasar-button quasar-button-fill @ConfirmationToneClass" @onclick="Confirm">
            <QuasarIcon Icon="@ConfirmationIcon" />
            @ConfirmationButtonText
        </button>
    }
</footer>

@code {
    /// <summary>
    /// Cascaded by the native dialog host. The component requests closure; the
    /// caller owns the result task.
    /// </summary>
    [CascadingParameter]
    private IQuasarDialogInstance Dialog { get; set; } = default!;

    /// <summary>Whether the restart action is available on this host.</summary>
    [Parameter]
    public bool IsRestartAvailable { get; set; }

    /// <summary>Explanation shown when restart is unavailable.</summary>
    [Parameter]
    public string RestartUnavailableReason { get; set; } = "Restart needs verified native services or the legacy Bootstrap launcher. Restart this process manually.";

    /// <summary>Grace period granted to agents after Quasar stops.</summary>
    [Parameter]
    public int AgentOfflineShutdownSeconds { get; set; }

    /// <summary>Version installed by a pending update, if any.</summary>
    [Parameter]
    public string? PendingUpdateVersion { get; set; }

    private QuasarControlAction? _pendingAction;

    /// <summary>
    /// Restart without a pending update is informational; the destructive
    /// actions use the warning border.
    /// </summary>
    private string? ConfirmationNoticeClass =>
        _pendingAction is QuasarControlAction.RestartQuasar && PendingUpdateVersion is null
            ? null
            : "quasar-notice-warning";

    /// <summary>Warning tone for restart, error tone for shutdown actions.</summary>
    private string ConfirmationToneClass =>
        _pendingAction is QuasarControlAction.RestartQuasar ? "quasar-tone-warning" : "quasar-tone-error";

    private string ConfirmationIcon => _pendingAction switch
    {
        QuasarControlAction.RestartQuasar => QuasarIcons.RestartAlt,
        QuasarControlAction.ShutdownAllServers => QuasarIcons.StopCircle,
        _ => QuasarIcons.PowerSettingsNew,
    };

    private string ConfirmationButtonText => _pendingAction switch
    {
        QuasarControlAction.RestartQuasar when PendingUpdateVersion is not null => "Update and Restart Quasar",
        QuasarControlAction.RestartQuasar => "Restart Quasar",
        QuasarControlAction.ShutdownAllServers => "Save and Stop Servers",
        _ => "Shutdown Quasar",
    };

    private string ConfirmationLead => _pendingAction switch
    {
        QuasarControlAction.RestartQuasar when PendingUpdateVersion is not null =>
            $"Quasar {PendingUpdateVersion} will also be installed during this restart. Running game servers continue to run.",
        QuasarControlAction.RestartQuasar => "Running servers continue to run.",
        QuasarControlAction.ShutdownAllServers => "Standalone servers and managed clusters will save and stop.",
        _ => "Quasar will stop. Running servers continue.",
    };

    private string ConfirmationBody => _pendingAction switch
    {
        QuasarControlAction.RestartQuasar =>
            "The native updater service or legacy Bootstrap launcher restarts Quasar. The web UI briefly disconnects, then reloads and re-adopts running servers by process id. Use this after restoring Quasar configuration from backup.",
        QuasarControlAction.ShutdownAllServers =>
            "Quasar stays online and shows shutdown progress. Standalone servers save and stop; clusters use their normal save-and-drain shutdown and wait for the Gateway to stop. Their goal states are set to Off so they stay stopped. Failures are shown without forcing processes to exit. Observed-only clusters are not managed by this action.",
        _ =>
            $"The web UI and supervisor stop, together with Bootstrap on legacy installs. The installed service or task will not restart Quasar automatically; start Quasar again when needed. Running servers are left detached and can continue for {FormatOfflineGrace()} without Quasar before their agent offline policy takes over.",
    };

    private void Select(QuasarControlAction action)
    {
        _pendingAction = action;
    }

    private void Back()
    {
        _pendingAction = null;
    }

    private void Cancel()
    {
        Dialog.Cancel();
    }

    private void Confirm()
    {
        if (_pendingAction is { } action)
            Dialog.Close(QuasarDialogResult.Ok(action));
    }

    private string FormatOfflineGrace()
    {
        if (AgentOfflineShutdownSeconds <= 0)
            return "no grace period";

        var span = TimeSpan.FromSeconds(AgentOfflineShutdownSeconds);
        if (span.TotalHours >= 1 && span.TotalHours % 1 == 0)
            return $"{(int)span.TotalHours} hour{(span.TotalHours == 1 ? string.Empty : "s")}";

        if (span.TotalMinutes >= 1 && span.TotalMinutes % 1 == 0)
            return $"{(int)span.TotalMinutes} minute{(span.TotalMinutes == 1 ? string.Empty : "s")}";

        return $"{AgentOfflineShutdownSeconds} second{(AgentOfflineShutdownSeconds == 1 ? string.Empty : "s")}";
    }
}
